{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "adminhead": {
      "source": { "source": "github", "repo": "Adminhead/claude-plugins" }
    }
  },
  "env": {
    "CLAUDE_CODE_GLOB_NO_IGNORE": "false"
  },
  "enabledPlugins": {
    "<plugin>@adminhead": true
  },
  "worktree": {
    "symlinkDirectories": ["node_modules", ".venv"]
  }
}
