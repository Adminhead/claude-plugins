#!/usr/bin/env bash
# claude-orchestrate: start Claude Code as an orchestrator: the orchestration agent's prompt
# (frontmatter stripped) is appended to Claude Code's default system prompt, CLAUDE_ORCHESTRATE=1
# tells agent-router to list the installed agents, and the Bash tool runs bash with agent.bashrc.
# Optionally inside herdr. With -a, the named agent runs through --agent instead.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: claude-orchestrate [OPTIONS] [DIR] [CLAUDE_ARGS...]

Runs Claude Code in DIR (default: $PWD) with the orchestration prompt (agents/orchestration.md
without its frontmatter) appended to the default system prompt, and CLAUDE_ORCHESTRATE=1 set
so agent-router lists the installed agents in the Agent tool. The Bash tool runs
bash with ~/.config/claude-orchestrate/agent.bashrc sourced before each command; the
first run copies templates/agent.bashrc there for you to edit.

herdr: inside a herdr pane (HERDR_ENV=1), Claude runs in this pane and keeps herdr's
variables, so herdr can track and resume the session. With --herdr outside herdr, it
starts the herdr server if needed, opens a workspace for DIR running Claude, and attaches.
HERDR_SESSION=NAME picks a named herdr session.

  -a, --agent AGENT   run AGENT with --agent instead (default: $CLAUDE_ORCHESTRATE_AGENT); it
                      gets no orchestration prompt and no CLAUDE_ORCHESTRATE
  -p, --prompt FILE   append FILE instead of the orchestration prompt
      --no-prompt     append nothing
  -H, --herdr         launch in a new herdr workspace (default when CLAUDE_ORCHESTRATE_HERDR=1)
      --no-herdr      run here even when CLAUDE_ORCHESTRATE_HERDR=1
  -t, --tab           inside herdr, open a new tab instead of using this pane
  -d, --detach        with --herdr, don't attach afterwards
  -n, --dry-run       print the commands instead of running them
  -h, --help          show this help

Arguments after DIR, or starting with "-" after the options above, go to claude:
  claude-orchestrate ~/code/api --resume
  claude-orchestrate -H ~/code/api -- --model opus
EOF
}

die() { echo "claude-orchestrate: $*" >&2; exit 1; }

root=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")
agent=${CLAUDE_ORCHESTRATE_AGENT:-}
prompt=
prompt_set=0
herdr_mode=${CLAUDE_ORCHESTRATE_HERDR:-0}
tab=0
attach=1
dry=0
while (($#)); do
  case $1 in
    -h|--help) usage; exit 0 ;;
    -a|--agent) (($# > 1)) || die "$1 needs an agent"; agent=$2; shift 2 ;;
    -p|--prompt) (($# > 1)) || die "$1 needs a file"; prompt=$(realpath -e -- "$2" 2>/dev/null) || die "no such prompt file: $2"; prompt_set=1; shift 2 ;;
    --no-prompt) prompt=; prompt_set=1; shift ;;
    -H|--herdr) herdr_mode=1; shift ;;
    --no-herdr) herdr_mode=0; shift ;;
    -t|--tab) tab=1; shift ;;
    -d|--detach) attach=0; shift ;;
    -n|--dry-run) dry=1; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done

dir=$PWD
if (($#)) && [[ $1 != -* ]]; then
  [[ -d $1 ]] || die "no such directory: $1"
  dir=$1
  shift
fi
[[ ${1:-} != -- ]] || shift
dir=$(cd "$dir" && pwd)

command -v claude >/dev/null || die "claude not found"
# Default route: the orchestration body appended to the default prompt. It is stripped at each
# launch into a real file, so the herdr paths can read it and it follows the installed plugin.
if [[ -z $agent && $prompt_set == 0 ]]; then
  state=${XDG_STATE_HOME:-$HOME/.local/state}/claude-orchestrate
  prompt=$state/orchestration.md
  [[ -f $root/agents/orchestration.md ]] || die "missing $root/agents/orchestration.md"
  if ((!dry)); then
    mkdir -p "$state"
    awk 'BEGIN{n=0} n>=2{print} /^---$/{n++}' "$root/agents/orchestration.md" | awk 'NF||started{started=1;print}' >"$prompt.tmp.$$"
    mv -f "$prompt.tmp.$$" "$prompt"
  fi
fi
[[ -z $prompt || -f $prompt ]] || ((dry)) || die "missing $prompt"

claude_args=()
[[ -z $agent ]] || claude_args+=(--agent "$agent")
[[ -z $prompt ]] || claude_args+=(--append-system-prompt-file "$prompt")
claude_args+=("$@")

# CLAUDE_CODE_SHELL points the Bash tool at bash, so the user's zsh or fish config never runs;
# CLAUDE_ENV_FILE is sourced before every Bash command.
bash_path=$(command -v bash) || die "bash not found"
launch_env=("CLAUDE_CODE_SHELL=$bash_path")
[[ -n $agent ]] || launch_env+=("CLAUDE_ORCHESTRATE=1")
bashrc=${XDG_CONFIG_HOME:-$HOME/.config}/claude-orchestrate/agent.bashrc
if [[ ! -e $bashrc && -f $root/templates/agent.bashrc ]] && ((!dry)); then
  mkdir -p "$(dirname "$bashrc")"
  cp "$root/templates/agent.bashrc" "$bashrc"
  echo "claude-orchestrate: created $bashrc; edit it to change the agents' Bash environment" >&2
fi
[[ ! -f $bashrc ]] || launch_env+=("CLAUDE_ENV_FILE=$bashrc")

run() {
  if ((dry)); then printf '%q ' "$@"; echo; return; fi
  "$@"
}

# Agent names: lowercase, start with a letter, at most 32 characters, unique among live agents.
herdr_agent_name() {
  local base n=1 name taken
  base=$(basename "$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || echo "$dir")")
  base=${base,,}
  base=${base//[^a-z0-9_-]/-}
  [[ $base =~ ^[a-z] ]] || base=claude-$base
  base=${base:0:28}
  taken=$(herdr agent list 2>/dev/null | jq -r '.result.agents[]?.name // empty' || true)
  name=$base
  while grep -qx -- "$name" <<<"$taken"; do n=$((n + 1)); name=$base-$n; done
  echo "$name"
}

# Opens a pane with `herdr <kind> create ...`, then starts Claude in it with `herdr agent start`.
herdr_start() {
  local create=("$@") reply pane name kv
  for kv in "${launch_env[@]}"; do create+=(--env "$kv"); done
  name=$(herdr_agent_name)
  if ((dry)); then
    run herdr "${create[@]}"
    run herdr agent start "$name" --kind claude --pane '<new pane>' -- "${claude_args[@]}"
    return
  fi
  reply=$(herdr "${create[@]}") || die "herdr ${create[0]} create failed"
  pane=$(jq -r '.result.root_pane.pane_id // .result.pane.pane_id // empty' <<<"$reply")
  [[ -n $pane ]] || die "herdr returned no pane: $reply"
  # agent_not_ready means Claude is up but waiting on a dialog, such as the folder trust
  # check, which the user answers after attaching.
  if ! reply=$(herdr agent start "$name" --kind claude --pane "$pane" -- "${claude_args[@]}" 2>&1 >/dev/null); then
    [[ $reply == *'"agent_not_ready"'* ]] || die "herdr agent start failed in pane $pane: $reply"
    echo "claude-orchestrate: $name is waiting on a prompt in pane $pane" >&2
  fi
}

herdr_hint() {
  if herdr integration status 2>/dev/null | grep -q '^claude: not installed'; then
    echo "claude-orchestrate: herdr's Claude integration is off, so herdr can't resume sessions; run: herdr integration install claude" >&2
  fi
}

if [[ ${HERDR_ENV:-} == 1 ]]; then
  command -v herdr >/dev/null && herdr_hint
  if ((tab)); then
    command -v herdr >/dev/null || die "HERDR_ENV=1 but herdr is not on PATH"
    command -v jq >/dev/null || die "jq not found"
    herdr_start tab create --cwd "$dir" --label "$(basename "$dir")" --focus
    exit 0
  fi
  # This pane: exec keeps HERDR_ENV, HERDR_SOCKET_PATH and HERDR_PANE_ID, which herdr's
  # Claude hook needs.
elif [[ $herdr_mode == 1 ]]; then
  command -v herdr >/dev/null || die "herdr not found; drop --herdr or install it"
  command -v jq >/dev/null || die "jq not found"
  herdr_hint
  if ! herdr status server 2>/dev/null | grep -q 'status: running'; then
    if ((dry)); then
      run herdr server
    else
      setsid herdr server </dev/null >/dev/null 2>&1 &
      for _ in $(seq 50); do
        herdr status server 2>/dev/null | grep -q 'status: running' && break
        sleep 0.1
      done
      herdr status server 2>/dev/null | grep -q 'status: running' || die "herdr server did not start"
    fi
  fi
  herdr_start workspace create --cwd "$dir" --label "$(basename "$dir")" --focus
  ((attach)) || exit 0
  if ((dry)); then run herdr; exit 0; fi
  exec herdr
fi

cd "$dir"
if ((dry)); then run env "${launch_env[@]}" claude "${claude_args[@]}"; exit 0; fi
exec env "${launch_env[@]}" claude "${claude_args[@]}"
