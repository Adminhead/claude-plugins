{
  "sentry": {
    "command": "npx",
    "args": ["-y", "@sentry/mcp-server@0.42.0"],
    "env": {
      "SENTRY_HOST": "${user_config.sentry_host}",
      "SENTRY_ACCESS_TOKEN": "${user_config.sentry_access_token}",
      "MCP_SKILLS": "${user_config.sentry_skills}",
      "SENTRY_URL": "",
